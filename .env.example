# Local-only port. Host binding is always 127.0.0.1 (not configurable).
L3D_PORT=4177
# Runtime job data path, if needed. Default: ./runtime/data
# L3D_DATA_DIR=D:\Velvet\Projects\local-3d-generator\runtime\data

# G2 is disabled by default. Never put a standing '1' into a global environment.
# To enable a temporary, manual Windows-only G2 session on port 4179 with
# independent data storage, invoke scripts/start-g2-manual.ps1 explicitly.
# L3D_ENABLE_TRIPOSR=1 (ONLY inside that operator-started process)
